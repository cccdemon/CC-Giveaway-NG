# Produktion: nach .env kopieren und ausfüllen. Compose liest diese Datei, die Prozesse bekommen ihre Werte aus docker-compose.yml.
# Öffentliche Domain des Neubaus (eigene Domain neben dem Altsystem, NEW_DESIGN.md 12.3).
DOMAIN=giveaway.example.org
# Host-Port, auf den der Edge (SNI-Passthrough) zeigt. Container lauscht auf 443.
CADDY_PORT=9445
# Caddyfile (TLS per Cloudflare DNS-01) oder Caddyfile.local (selbst signiert, Entwicklerrechner).
CADDY_CONFIG=Caddyfile
# Cloudflare-API-Token mit Zone:DNS:Edit für die Domain (nur für Caddyfile).
CF_API_TOKEN=
# Passwort der PostgreSQL-Rolle ccg (Datenbank ccg).
PG_PASSWORD=
# Twitch-App: Redirect-URL = https://DOMAIN/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch-ID des Plattform-Bots (README „Bot einrichten“), Pflicht bei INGEST_ADAPTER=twitch.
TWITCH_BOT_USER_ID=
# Superadmins der Verwaltung: Twitch-IDs, kommagetrennt.
ADMIN_TWITCH_IDS=
# twitch oder simulator
INGEST_ADAPTER=twitch
# Zahl der Ingest-Worker (bei mehr als 1: weitere ingest-Dienste mit INGEST_WORKER_INDEX 1..n-1 anlegen).
INGEST_WORKERS=1
LOG_LEVEL=info
