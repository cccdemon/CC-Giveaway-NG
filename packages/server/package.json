  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
