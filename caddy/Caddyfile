# Produktion (NEW_DESIGN.md 3.2, 12.3): TLS per Cloudflare DNS-01, weil am Edge (LXC 101, SNI-Passthrough) kein Port 80 ankommt.
# /api/* und /healthz gehen an den app-Prozess, alles andere an die Web-App. Caddy setzt X-Forwarded-For, -Proto und -Host.
# Hinweis: Läuft ein L4-Proxy davor, sieht Caddy dessen Adresse. Reicht der Proxy das PROXY-Protokoll durch, hier einschalten:
#   servers { listener_wrappers { proxy_protocol { allow 10.0.0.0/8 } tls } }
{
    admin off
    auto_https disable_redirects
    acme_dns cloudflare {env.CF_API_TOKEN}
    order rate_limit before basic_auth
}

{$DOMAIN} {
    encode gzip
    # Zugriffslog nach stdout (docker compose logs caddy): zeigt auch, welche Adresse Caddy als Client sieht (Ratelimit je Adresse).
    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # SvelteKit hydriert mit einem Inline-Skript, darum 'unsafe-inline'. Twitch-Avatare von static-cdn.jtvnw.net.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        -Server
    }

    # Grenzen je Adresse (NEW_DESIGN.md 11.4 Browser-Fehler, 9.2 Anmeldung, Rückmeldungen).
    rate_limit {
        zone errors {
            match {
                method POST
                path /api/errors
            }
            key {remote_host}
            events 10
            window 1m
        }
        zone auth {
            match {
                path /api/auth/*
            }
            key {remote_host}
            events 30
            window 1m
        }
        zone feedback {
            match {
                method POST
                path /api/feedback
            }
            key {remote_host}
            events 5
            window 1m
        }
    }

    @api path /api/* /healthz
    handle @api {
        reverse_proxy app:3000
    }

    handle {
        reverse_proxy web:3000
    }
}
