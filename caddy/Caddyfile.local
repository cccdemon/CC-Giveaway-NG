# Entwicklerrechner: dieselben Routen und Grenzen, Zertifikat selbst signiert (Browser warnt einmal).
# Aufruf: CADDY_CONFIG=Caddyfile.local DOMAIN=localhost docker compose up -d --build, dann https://localhost:9445
{
    admin off
    auto_https disable_redirects
    order rate_limit before basic_auth
}

{$DOMAIN} {
    tls internal
    encode gzip
    # Zugriffslog nach stdout (docker compose logs caddy): zeigt auch, welche Adresse Caddy als Client sieht (Ratelimit je Adresse).
    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        -Server
    }

    rate_limit {
        zone errors {
            match {
                method POST
                path /api/errors
            }
            key {remote_host}
            events 10
            window 1m
        }
        zone auth {
            match {
                path /api/auth/*
            }
            key {remote_host}
            events 30
            window 1m
        }
        zone feedback {
            match {
                method POST
                path /api/feedback
            }
            key {remote_host}
            events 5
            window 1m
        }
    }

    @api path /api/* /healthz
    handle @api {
        reverse_proxy app:3000
    }

    handle {
        reverse_proxy web:3000
    }
}
