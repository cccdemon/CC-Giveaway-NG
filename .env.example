NODE_ENV=development
DATABASE_URL=postgres://ccg:ccg@localhost:5433/ccg
REDIS_URL=redis://localhost:6380
PORT=3000
LOG_LEVEL=info
# Twitch-App (https://dev.twitch.tv/console): Redirect-URL = PUBLIC_URL + /auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
# Schlüssel für Kanal-Tokens, anlegen mit: openssl rand -hex 32 > secrets/token.key
TOKEN_KEY_FILE=./secrets/token.key
