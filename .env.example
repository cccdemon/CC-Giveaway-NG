NODE_ENV=development
DATABASE_URL=postgres://ccg:ccg@localhost:5433/ccg
REDIS_URL=redis://localhost:6380
PORT=3000
LOG_LEVEL=info
# Twitch-App (https://dev.twitch.tv/console): Redirect-URL = PUBLIC_URL + /api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3001
# Schlüssel für Kanal-Tokens, anlegen mit: openssl rand -hex 32 > secrets/token.key
TOKEN_KEY_FILE=./secrets/token.key
INGEST_ADAPTER=simulator
INGEST_WORKERS=1
INGEST_WORKER_INDEX=0
# Twitch-ID des Plattform-Bots, Pflicht bei INGEST_ADAPTER=twitch (README: Bot einrichten)
TWITCH_BOT_USER_ID=
# Web-App (packages/web): Adresse des app-Prozesses für das Server-Rendern, Port der Web-App
API_URL=http://localhost:3000
WEB_PORT=3001
